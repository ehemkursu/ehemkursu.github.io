{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "kursiyerler": {
      ".indexOn": ["username", "classId"]
    },
    "classes": {
      ".indexOn": ["name"]
    },
    "announcements": {
      ".indexOn": ["createdAt"]
    },
    "messages": {
      ".indexOn": ["recipientId", "senderId", "createdAt"]
    },
    "deleted_users": {
      ".indexOn": [".value"]
    },
    "custom_modules": {
      ".indexOn": ["id"]
    },
    "_system_ping": {
      ".indexOn": ["ts"]
    }
  }
}
