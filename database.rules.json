{
  "rules": {
    ".read": true,
    ".write": true,
    "kursiyerler": {
      ".indexOn": ["username", "classId"]
    },
    "classes": {
      ".indexOn": ["name"]
    },
    "announcements": {
      ".indexOn": ["createdAt"]
    },
    "messages": {
      ".indexOn": ["recipientId", "senderId", "createdAt"]
    },
    "deleted_users": {
      ".indexOn": [".value"]
    },
    "custom_modules": {
      ".indexOn": ["id"]
    },
    "exams_v2": {
      ".indexOn": ["createdAt", "targetClassId", "status"]
    },
    "exam_submissions_v2": {
      ".indexOn": ["examId", "studentId", "submittedAt", "status"]
    },
    "deleted_exams_v2": {
      ".indexOn": [".value"]
    },
    "_system_ping": {
      ".indexOn": ["ts"]
    }
  }
}
