{
  "rules": {
    "kursiyerler": {
      ".read": true,
      ".write": true,
      ".indexOn": ["username", "classId"]
    },
    "classes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["name"]
    },
    "announcements": {
      ".read": true,
      ".write": true,
      ".indexOn": ["createdAt"]
    },
    "messages": {
      ".read": true,
      ".write": true,
      ".indexOn": ["recipientId", "senderId", "createdAt"]
    },
    "custom_modules": {
      ".read": true,
      ".write": true,
      ".indexOn": ["id"]
    },
    "exams_v2": {
      ".read": true,
      ".write": true,
      ".indexOn": ["createdAt", "targetClassId", "status"]
    },
    "exam_submissions_v2": {
      ".read": true,
      ".write": true,
      ".indexOn": ["examId", "studentId", "submittedAt", "status"]
    },
    "deleted_users": {
      ".read": true,
      ".write": true
    },
    "deleted_submissions_v2": {
      ".read": true,
      ".write": true
    },
    "deleted_exams_v2": {
      ".read": true,
      ".write": true
    },
    "exam_header_settings_v1": {
      ".read": true,
      ".write": true
    },
    "theme_settings": {
      ".read": true,
      ".write": true
    },
    "_system_ping": {
      ".read": true,
      ".write": true
    }
  }
}
